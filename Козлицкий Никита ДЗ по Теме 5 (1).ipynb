{"cells":[{"cell_type":"markdown","id":"338fb7c3","metadata":{"id":"338fb7c3"},"source":["# Домашнее задание 5\n","## Тема: Классы и объекты (ООП)\n"]},{"cell_type":"code","execution_count":4,"id":"ff4ba5a7","metadata":{"id":"ff4ba5a7","executionInfo":{"status":"ok","timestamp":1773676795972,"user_tz":-180,"elapsed":113,"user":{"displayName":"Nik K","userId":"16512716673622748505"}}},"outputs":[],"source":["from datetime import datetime\n","\n","\n","class Account:\n","    \"\"\"Базовый банковский счёт.\n","\n","    Хранит владельца счёта, текущий баланс и историю операций.\n","    Поддерживает пополнение, снятие средств и получение информации по счёту.\n","    \"\"\"\n","\n","    def __init__(self, account_holder, balance=0):\n","        \"\"\"Создаёт банковский счёт.\n","\n","        Args:\n","            account_holder (str): Имя владельца счёта.\n","            balance (float | int, optional): Начальный баланс. По умолчанию 0.\n","\n","        Raises:\n","            ValueError: Если начальный баланс отрицательный.\n","        \"\"\"\n","        if balance < 0:\n","            raise ValueError(\"Начальный баланс не может быть отрицательным.\")\n","\n","        self.holder = account_holder\n","        self._balance = float(balance)\n","        self.operations_history = []\n","\n","    def deposit(self, amount):\n","        \"\"\"Пополняет счёт на указанную сумму.\n","\n","        Args:\n","            amount (float | int): Сумма пополнения.\n","\n","        Returns:\n","            str: Сообщение о результате операции.\n","        \"\"\"\n","        if amount <= 0:\n","            self._add_operation(\"deposit\", amount, \"fail\")\n","            return \"Сумма пополнения должна быть положительной.\"\n","\n","        self._balance += amount\n","        self._add_operation(\"deposit\", amount, \"success\")\n","        return \"Счет успешно пополнен.\"\n","\n","    def withdraw(self, amount):\n","        \"\"\"Снимает средства со счёта, если на балансе достаточно денег.\n","\n","        Args:\n","            amount (float | int): Сумма снятия.\n","\n","        Returns:\n","            str: Сообщение о результате операции.\n","        \"\"\"\n","        if amount <= 0:\n","            self._add_operation(\"withdraw\", amount, \"fail\")\n","            return \"Сумма снятия должна быть положительной.\"\n","\n","        if amount > self._balance:\n","            self._add_operation(\"withdraw\", amount, \"fail\")\n","            return \"Недостаточно средств на счете.\"\n","\n","        self._balance -= amount\n","        self._add_operation(\"withdraw\", amount, \"success\")\n","        return \"Средства успешно сняты.\"\n","\n","    def get_balance(self):\n","        \"\"\"Возвращает текущий баланс счёта.\n","\n","        Returns:\n","            float: Текущий баланс.\n","        \"\"\"\n","        return self._balance\n","\n","    def get_history(self):\n","        \"\"\"Возвращает копию истории операций.\n","\n","        Returns:\n","            list[dict]: Список операций по счёту.\n","        \"\"\"\n","        return self.operations_history.copy()\n","\n","    def _add_operation(self, operation_type, amount, status):\n","        \"\"\"Добавляет запись об операции в историю.\"\"\"\n","        operation = {\n","            \"type\": operation_type,\n","            \"amount\": float(amount),\n","            \"datetime\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n","            \"balance_after\": self._balance,\n","            \"status\": status,\n","        }\n","        self.operations_history.append(operation)\n","\n","\n","class CreditAccount(Account):\n","    \"\"\"Кредитный счёт с возможностью ухода в минус в пределах кредитного лимита.\"\"\"\n","\n","    def __init__(self, account_holder, balance=0, credit_limit=0):\n","        \"\"\"Создаёт кредитный счёт.\n","\n","        Args:\n","            account_holder (str): Имя владельца счёта.\n","            balance (float | int, optional): Начальный баланс.\n","            credit_limit (float | int, optional): Размер кредитного лимита.\n","\n","        Raises:\n","            ValueError: Если кредитный лимит отрицательный или начальный\n","                баланс меньше допустимого минимума.\n","        \"\"\"\n","        if credit_limit < 0:\n","            raise ValueError(\"Кредитный лимит не может быть отрицательным.\")\n","\n","        if balance < -credit_limit:\n","            raise ValueError(\n","                \"Начальный баланс не может быть меньше кредитного лимита.\"\n","            )\n","\n","        super().__init__(account_holder, 0)\n","        self._balance = float(balance)\n","        self.credit_limit = float(credit_limit)\n","\n","    def deposit(self, amount):\n","        \"\"\"Пополняет кредитный счёт на указанную сумму.\n","\n","        Args:\n","            amount (float | int): Сумма пополнения.\n","\n","        Returns:\n","            str: Сообщение о результате операции.\n","        \"\"\"\n","        if amount <= 0:\n","            self._add_operation(\"deposit\", amount, \"fail\", self._balance < 0)\n","            return \"Сумма пополнения должна быть положительной.\"\n","\n","        self._balance += amount\n","        self._add_operation(\"deposit\", amount, \"success\", self._balance < 0)\n","        return \"Счет успешно пополнен.\"\n","\n","    def withdraw(self, amount):\n","        \"\"\"Снимает средства с учётом кредитного лимита.\n","\n","        Args:\n","            amount (float | int): Сумма снятия.\n","\n","        Returns:\n","            str: Сообщение о результате операции.\n","        \"\"\"\n","        if amount <= 0:\n","            self._add_operation(\"withdraw\", amount, \"fail\", self._balance < 0)\n","            return \"Сумма снятия должна быть положительной.\"\n","\n","        if self._balance - amount < -self.credit_limit:\n","            future_balance = self._balance - amount\n","            self._add_operation(\"withdraw\", amount, \"fail\", future_balance < 0)\n","            return \"Превышен кредитный лимит.\"\n","\n","        self._balance -= amount\n","        self._add_operation(\"withdraw\", amount, \"success\", self._balance < 0)\n","        return \"Средства успешно сняты.\"\n","\n","    def get_available_credit(self):\n","        \"\"\"Возвращает доступный остаток кредитных средств.\n","\n","        Returns:\n","            float: Сумма доступных средств с учётом кредитного лимита.\n","        \"\"\"\n","        return self._balance + self.credit_limit\n","\n","    def _add_operation(self, operation_type, amount, status, credit_used):\n","        \"\"\"Добавляет запись об операции в историю кредитного счёта.\"\"\"\n","        operation = {\n","            \"type\": operation_type,\n","            \"amount\": float(amount),\n","            \"datetime\": datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\"),\n","            \"balance_after\": self._balance,\n","            \"status\": status,\n","            \"credit_used\": credit_used,\n","        }\n","        self.operations_history.append(operation)"]},{"cell_type":"markdown","id":"4138d112","metadata":{"id":"4138d112"},"source":["## Проверка класса `Account`"]},{"cell_type":"code","execution_count":5,"id":"e90246d3","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"e90246d3","executionInfo":{"status":"ok","timestamp":1773676796007,"user_tz":-180,"elapsed":65,"user":{"displayName":"Nik K","userId":"16512716673622748505"}},"outputId":"225bc3e4-c7a3-4a43-ef39-ab51c00cc66b"},"outputs":[{"output_type":"stream","name":"stdout","text":["Счет успешно пополнен.\n","Средства успешно сняты.\n","Недостаточно средств на счете.\n","Текущий баланс: 1300.0\n","\n","История операций:\n","{'type': 'deposit', 'amount': 500.0, 'datetime': '2026-03-16 15:59:55', 'balance_after': 1500.0, 'status': 'success'}\n","{'type': 'withdraw', 'amount': 200.0, 'datetime': '2026-03-16 15:59:55', 'balance_after': 1300.0, 'status': 'success'}\n","{'type': 'withdraw', 'amount': 2000.0, 'datetime': '2026-03-16 15:59:55', 'balance_after': 1300.0, 'status': 'fail'}\n"]}],"source":["account = Account(\"Иван\", 1000)\n","\n","print(account.deposit(500))\n","print(account.withdraw(200))\n","print(account.withdraw(2000))\n","print(\"Текущий баланс:\", account.get_balance())\n","print()\n","\n","print(\"История операций:\")\n","for operation in account.get_history():\n","    print(operation)\n"]},{"cell_type":"markdown","id":"277bc086","metadata":{"id":"277bc086"},"source":["## Проверка класса `CreditAccount`"]},{"cell_type":"code","execution_count":6,"id":"cd2daf8c","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"cd2daf8c","executionInfo":{"status":"ok","timestamp":1773676796024,"user_tz":-180,"elapsed":16,"user":{"displayName":"Nik K","userId":"16512716673622748505"}},"outputId":"15afac1c-20f3-41d5-eba4-3fa314615331"},"outputs":[{"output_type":"stream","name":"stdout","text":["Средства успешно сняты.\n","Средства успешно сняты.\n","Счет успешно пополнен.\n","Текущий баланс: -700.0\n","Доступные кредитные средства: 300.0\n","\n","История операций:\n","{'type': 'withdraw', 'amount': 500.0, 'datetime': '2026-03-16 15:59:55', 'balance_after': -200.0, 'status': 'success', 'credit_used': True}\n","{'type': 'withdraw', 'amount': 700.0, 'datetime': '2026-03-16 15:59:55', 'balance_after': -900.0, 'status': 'success', 'credit_used': True}\n","{'type': 'deposit', 'amount': 200.0, 'datetime': '2026-03-16 15:59:55', 'balance_after': -700.0, 'status': 'success', 'credit_used': True}\n"]}],"source":["credit_account = CreditAccount(\"Мария\", 300, 1000)\n","\n","print(credit_account.withdraw(500))\n","print(credit_account.withdraw(700))\n","print("изменение для ДЗ_6")\n","print(credit_account.deposit(200))\n","print(\"Текущий баланс:\", credit_account.get_balance())\n","print(\"Доступные кредитные средства:\", credit_account.get_available_credit())\n","print()\n","\n","print(\"История операций:\")\n","for operation in credit_account.get_history():\n","    print(operation)\n"]}],"metadata":{"colab":{"provenance":[]},"kernelspec":{"display_name":"Python 3","language":"python","name":"python3"},"language_info":{"name":"python","version":"3.10"}},"nbformat":4,"nbformat_minor":5}
